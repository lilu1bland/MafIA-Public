{
  "name": "mafia-public",
  "version": "0.1.0",
  "tasks": {
    "dev": "deno run --allow-net --allow-read --allow-env --allow-write --unstable-kv --watch main.ts",
    "start": "deno run --allow-net --allow-read --allow-env --allow-write --unstable-kv main.ts",
    "check": "deno check main.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@anthropic-ai/sdk": "npm:@anthropic-ai/sdk@^0.71.0",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.2",
    "@std/media-types": "jsr:@std/media-types@^1.0.3",
    "@std/path": "jsr:@std/path@^1.0.8"
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compilerOptions": {
    "lib": ["deno.window", "deno.unstable", "dom"],
    "strict": true
  }
}
